{
  "name": "cyberclaw",
  "version": "3.1.42",
  "description": "CyberClaw — AI companion you can play and talk to. RPG-style progression, quests, and a task system. Pairs with the CyberClaw mobile app for voice and agent reach.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "dist": "electron-builder --linux --win --mac --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tobe2222/CyberClaw.git"
  },
  "author": {
    "name": "CyberHive Digital",
    "email": "dev@cyberhive.digital"
  },
  "license": "MIT",
  "build": {
    "appId": "com.cyberhive.cyberclaw",
    "productName": "CyberClaw",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "src/assets/icons/cyberclaw.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/icons/cyberclaw.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icons/cyberclaw.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  }
}
