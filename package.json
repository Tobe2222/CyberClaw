{
  "name": "cyberclaw",
  "version": "0.1.0",
  "description": "CyberClaw — RPG-style GUI companion for OpenClaw AI agents. Install, manage, and command your AI party.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --linux --win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tobe2222/CyberClaw.git"
  },
  "author": "CyberHive Digital",
  "license": "MIT",
  "build": {
    "appId": "com.cyberhive.cyberclaw",
    "productName": "CyberClaw",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "src/assets/icons"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/icons/cyberclaw.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icons/cyberclaw.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToDesktop": true,
      "installerIcon": "src/assets/icons/cyberclaw.ico",
      "uninstallerIcon": "src/assets/icons/cyberclaw.ico",
      "installerHeaderIcon": "src/assets/icons/cyberclaw.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Tobe2222",
      "repo": "CyberClaw"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  }
}
